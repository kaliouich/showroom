{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Mises a jour en attente",
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/.+\\.ya?ml$/",
      "/^ci/.+\\.ya?ml$/",
      "/^n8n\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Versions de charts Helm de infra/ansible/group_vars/all.yml, annotees par un commentaire 'renovate:'",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\n(?:\\s*#.*\\n)*\\s+\\w+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Images construites sur le noeud, sans registre : rien a chercher en amont.",
      "matchPackageNames": [
        "gitea-runner-ci",
        "event-feed",
        "showcase-website"
      ],
      "enabled": false
    },
    {
      "description": "Le reste : un lot par semaine, relu avant fusion. Premiere regle, pour que les suivantes (majeures, Gitea) la surchargent.",
      "matchPackageNames": [
        "*"
      ],
      "schedule": [
        "before 8am on monday"
      ],
      "groupName": "mises a jour hebdomadaires"
    },
    {
      "description": "Les majeures : une par paquet, jamais fusionnees seules, et seulement sur demande depuis le tableau de bord (case a cocher).",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Postgres 16 -> 18 : le repertoire de donnees n'est pas lisible d'une majeure a l'autre, un simple changement d'image planterait le pod. Migration par dump/restore, a la main.",
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Gitea est expose sur Internet (incident 12) : chart et image ensemble, a toute heure, fusion automatique des correctifs et mineures.",
      "matchPackageNames": [
        "gitea",
        "gitea/gitea",
        "docker.io/gitea/gitea"
      ],
      "groupName": "gitea",
      "schedule": [
        "at any time"
      ],
      "labels": [
        "dependencies",
        "security"
      ],
      "prPriority": 10,
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  }
}
